function doPost(e){var d=JSON.parse(e.postData.contents);var s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName("Responses");s.appendRow([new Date(),d.response||"",d.dateType||"",d.preferredDate||"",d.preferredTime||"",d.message||"",d.page||""]);return ContentService.createTextOutput("ok");}function doGet(){return ContentService.createTextOutput("Response endpoint is active.");}